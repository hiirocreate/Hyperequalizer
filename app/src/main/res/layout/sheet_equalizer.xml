<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/hyper_surface"
    android:paddingBottom="24dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="20dp">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eq_title"
            android:textColor="@color/hyper_on_surface"
            android:textSize="18sp"
            android:textStyle="bold" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <com.google.android.material.switchmaterial.SwitchMaterial
                android:id="@+id/eqEnableSwitch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eq_enable"
                android:textColor="@color/hyper_on_surface" />

            <com.google.android.material.button.MaterialButton
                android:id="@+id/btnEqReset"
                style="@style/Widget.MaterialComponents.Button.TextButton"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/eq_reset"
                android:textColor="@color/hyper_muted"
                android:textSize="12sp" />
        </LinearLayout>

        <!-- 各帯域: 左が周波数(この帯域が担当する音域)、右が現在のゲイン値。
             0dBが基準(変化なし)、プラスでその帯域を強調、マイナスで抑える。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="4dp"
            android:text="@string/eq_bands_hint"
            android:textColor="@color/hyper_muted"
            android:textSize="11sp" />

        <LinearLayout
            android:id="@+id/bandsContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="vertical" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="16dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eq_bass_boost"
                android:textColor="@color/hyper_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/bassBoostValueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hyper_on_surface"
                android:textSize="13sp"
                tools:text="40%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/bassBoostSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="1000"
            android:progressTint="@color/hyper_accent"
            android:thumbTint="@color/hyper_accent" />

        <View
            android:layout_width="match_parent"
            android:layout_height="1dp"
            android:layout_marginVertical="16dp"
            android:background="#33FFFFFF" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="@string/eq_separation_title"
            android:textColor="@color/hyper_on_surface"
            android:textSize="15sp"
            android:textStyle="bold" />

        <!-- 何ができる機能なのかが分かりにくいという声があったため、
             一言で説明する補足文を追加した。 -->
        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/eq_separation_explainer"
            android:textColor="@color/hyper_muted"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/separationStatusText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:textColor="@color/hyper_muted"
            android:textSize="12sp" />

        <ProgressBar
            android:id="@+id/separationProgress"
            style="?android:attr/progressBarStyleHorizontal"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:max="100"
            android:visibility="gone" />

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnSeparateNow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/eq_separate_now" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="14dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eq_vocal_volume"
                android:textColor="@color/hyper_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/vocalVolumeValueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hyper_on_surface"
                android:textSize="13sp"
                tools:text="100%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/vocalVolumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:progressTint="@color/hyper_accent"
            android:thumbTint="@color/hyper_accent" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:orientation="horizontal">

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/eq_instrumental_volume"
                android:textColor="@color/hyper_muted"
                android:textSize="13sp" />

            <TextView
                android:id="@+id/instrumentalVolumeValueLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/hyper_on_surface"
                android:textSize="13sp"
                tools:text="100%" />
        </LinearLayout>

        <SeekBar
            android:id="@+id/instrumentalVolumeSeekBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:max="200"
            android:progress="100"
            android:progressTint="@color/hyper_accent"
            android:thumbTint="@color/hyper_accent" />
    </LinearLayout>
</ScrollView>
