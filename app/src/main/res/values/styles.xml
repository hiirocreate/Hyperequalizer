<?xml version="1.0" encoding="utf-8"?>
<resources>
    <style name="PlayerIconButton">
        <item name="android:layout_width">44dp</item>
        <item name="android:layout_height">44dp</item>
        <item name="android:layout_margin">2dp</item>
        <item name="android:background">?attr/selectableItemBackgroundBorderless</item>
        <item name="android:padding">10dp</item>
        <item name="android:scaleType">fitCenter</item>
    </style>

    <style name="PlayerTextChip">
        <item name="android:layout_width">wrap_content</item>
        <item name="android:layout_height">36dp</item>
        <item name="android:layout_margin">4dp</item>
        <item name="android:background">@drawable/bg_chip</item>
        <item name="android:gravity">center</item>
        <item name="android:minWidth">44dp</item>
        <item name="android:paddingHorizontal">14dp</item>
        <item name="android:textColor">@color/hyper_on_surface</item>
        <item name="android:textSize">13sp</item>
    </style>
</resources>
